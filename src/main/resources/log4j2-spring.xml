<?xml version="1.0" encoding="UTF-8"?>

<Configuration status="WARN">

  <!-- 공통 속성 정의 -->
  <Properties>
    <Property name="logDir" value="logs"/>
    <Property name="maxFileSize" value="50 MB"/>
    <!-- 콘솔 색상 로그 -->
    <Property name="CONSOLE_LOG_PATTERN">
      <![CDATA[%d{yy-MM-dd HH:mm:ss.SSS} [%t] %highlight{%-5level} %style{%logger{36}}{yellow} %style{[%equals{%X{traceId}}{}{anonymous} | %equals{%X{requestMethod}}{}{-} | %equals{%X{requestUrl}}{}{-}]}{cyan} - %msg%n]]></Property>
    <!-- 파일 로그 -->
    <Property name="FILE_LOG_PATTERN">
      <![CDATA[%d{yy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} [%equals{%X{traceId}}{}{anonymous} | %equals{%X{requestMethod}}{}{-} | %equals{%X{requestUrl}}{}{-}] - %msg%n]]></Property>
  </Properties>

  <!-- 로그 출력 위치 설정 -->
  <Appenders>
    <!-- 콘솔 로그 -->
    <Console name="CONSOLE">
      <PatternLayout disableAnsi="false" pattern="${CONSOLE_LOG_PATTERN}"/>
    </Console>

    <!-- JSON 로그 -->
    <RollingFile name="JSON_FILE_LOG" fileName="${logDir}/main.log"
      filePattern="${logDir}/main-%d{yyyy-MM-dd}-%i.log.gz">
      <ThresholdFilter level="INFO" onMatch="ACCEPT" onMismatch="DENY"/>
      <JsonTemplateLayout/>
      <Policies>
        <TimeBasedTriggeringPolicy interval="1"/>
        <SizeBasedTriggeringPolicy size="${maxFileSize}"/>
      </Policies>
      <DefaultRolloverStrategy max="30"/>
    </RollingFile>

    <!-- 디버그 로그 -->
    <RollingFile name="DEBUG_FILE_LOG" fileName="${logDir}/debug.log"
      filePattern="${logDir}/debug-%d{yyyy-MM-dd}-%i.log.gz">
      <!-- INFO 이상은 거부 (DEBUG/TRACE만 기록) -->
      <ThresholdFilter level="INFO" onMatch="DENY" onMismatch="NEUTRAL"/>
      <PatternLayout pattern="${FILE_LOG_PATTERN}"/>
      <Policies>
        <TimeBasedTriggeringPolicy interval="1"/>
        <SizeBasedTriggeringPolicy size="${maxFileSize}"/>
      </Policies>
      <DefaultRolloverStrategy max="30"/>
    </RollingFile>
  </Appenders>


  <!--
    로그 레벨 및 Logger 설정
    프로필 설정(application*.yaml)에서 적용되는 로그 레벨을 받을 수 있는 레벨 정의.
  -->
  <Loggers>
    <Root level="INFO">
      <AppenderRef ref="CONSOLE"/>
      <AppenderRef ref="JSON_FILE_LOG"/>
    </Root>

    <Logger name="com.sprint" level="INFO">
      <AppenderRef ref="DEBUG_FILE_LOG"/>
    </Logger>

    <Logger name="org.hibernate" level="WARN"/>

    <!-- p6spy: 콘솔 제거, 기본 INFO. DEBUG 필요 시 동적 전환 -->
    <Logger name="p6spy" level="INFO">
      <AppenderRef ref="CONSOLE"/>
      <AppenderRef ref="DEBUG_FILE_LOG" level="DEBUG"/>
    </Logger>
  </Loggers>

</Configuration>